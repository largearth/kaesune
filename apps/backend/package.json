{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "pnpm --filter web build:production && wrangler deploy --dry-run --outdir dist",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx src/db/seed.ts",
    "verify:seed-payment-create": "tsx src/db/verify-payment-create.ts",
    "verify:seed-records-delete": "tsx src/db/verify-records-delete.ts",
    "verify:seed-wallet-delete": "tsx src/db/verify-wallet-delete.ts",
    "deploy": "pnpm --filter web build:production && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.29",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.6.29",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
